Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-Vendor: %providerName
Bundle-SymbolicName: com.github.vvi3ard.dt.linkifier;singleton:=true
Bundle-Version: 1.1.0.qualifier
Bundle-Activator: com.github.vvi3ard.dt.linkifier.LinkifierPlugin
Bundle-ActivationPolicy: lazy
Bundle-Localization: plugin
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.swt,
 org.eclipse.equinox.preferences
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=17))"
Automatic-Module-Name: com.github.vvi3ard.dt.linkifier
Export-Package: com.github.vvi3ard.dt.linkifier,
 com.github.vvi3ard.dt.linkifier.core,
 com.github.vvi3ard.dt.linkifier.detector,
 com.github.vvi3ard.dt.linkifier.model,
 com.github.vvi3ard.dt.linkifier.preferences
